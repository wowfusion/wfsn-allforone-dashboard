// Prisma Schema – All for One Raidbuilder
// Datenbankmodell für Raids, Signups, DropHistory und Discord-Integration.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// #region Auth & User

/** Discord-authentifizierter Nutzer der App */
model User {
  id            String    @id @default(cuid())
  discordId     String    @unique
  name          String
  email         String?
  avatar        String?
  /** Snapshot der Discord-Rollen zum Zeitpunkt des letzten Logins */
  rolesSnapshot String[]
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  signups         Signup[]
  dropHistory     DropHistory[]
  createdEvents   Event[]          @relation("EventCreator")
  signupActivities SignupActivity[]

  // NextAuth Session-Felder
  accounts Account[]
  sessions Session[]
}

/** NextAuth Account (OAuth Provider) */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/** NextAuth Session */
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** NextAuth VerificationToken */
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// #endregion

// #region WoW Spieler/Roster

/** WoW-Charakter aus dem Gilden-Roster (Battle.net Sync) */
model Player {
  id            String    @id @default(cuid())
  characterName String
  realm         String
  realmSlug     String
  faction       String?
  classId       Int
  className     String
  specName      String?
  role          String?   // TANK | HEALER | DPS
  level         Int
  isMaxLevel    Boolean   @default(false)
  guildRank     Int?
  itemLevel     Int?
  mythicRating  Float?
  lastSync      DateTime  @default(now())
  createdAt     DateTime  @default(now())

  signups Signup[]

  @@unique([characterName, realmSlug])
}

// #endregion

// #region Raid/Event Domain

/** Ein geplantes Raid oder Event */
model Event {
  id               String      @id @default(cuid())
  title            String
  type             EventType   @default(RAID)
  description      String?     @db.Text
  startAt          DateTime
  endAt            DateTime
  lockAt           DateTime?
  /** Maximale Slots gesamt (optional) */
  maxSlots         Int?
  /** Slot-Aufteilung: Tank/Heal/DPS (JSON: {tank: 2, healer: 4, dps: 14}) */
  roleSlots        Json?
  status           EventStatus @default(DRAFT)
  createdBy        String
  creator          User        @relation("EventCreator", fields: [createdBy], references: [id])
  /** Cover-Bild als Base64 (für Discord Scheduled Event) */
  coverImage       String?   @db.Text
  /** Raidlead – Charaktername aus dem Roster (optional, nur bei RAID) */
  raidLeadName     String?
  /** Discord Scheduled Event ID */
  discordEventId   String?
  /** Sync-Status mit Discord */
  discordSyncStatus DiscordSyncStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  signups          Signup[]
  dropHistory      DropHistory[]
  lockSnapshot     LockSnapshot?
  discordRsvps     DiscordRsvp[]
  raidSlots        RaidSlot[]
  signupActivities SignupActivity[]
}

enum EventType {
  RAID
  EVENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LOCKED
  DONE
}

enum DiscordSyncStatus {
  PENDING
  SYNCED
  FAILED
}

/** Anmeldung eines Users (+ optionaler Charakter) zu einem Event */
model Signup {
  id        String       @id @default(cuid())
  eventId   String
  userId    String
  playerId  String?
  status    SignupStatus @default(GOING)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id])

  @@unique([eventId, userId])
}

enum SignupStatus {
  GOING
  MAYBE
  DECLINED
  WAITLIST
}

/** Kurzfristige Abmeldung: „erst angemeldet, dann abgesagt" */
model DropHistory {
  id             String   @id @default(cuid())
  eventId        String
  userId         String
  /** War der User vorher GOING oder MAYBE? */
  previousStatus String
  droppedAt      DateTime @default(now())
  /** War die Abmeldung nach lockAt oder innerhalb der Kurzfrist-Schwelle? */
  isShortNotice  Boolean  @default(false)
  reason         String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Finaler Snapshot beim Locking – unveränderlich */
model LockSnapshot {
  id           String   @id @default(cuid())
  eventId      String   @unique
  lockedAt     DateTime @default(now())
  lockedBy     String
  /** JSON: { going: [...], waitlist: [...], declined: [...] } */
  snapshotJson Json

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// #region Discord RSVP & Kaderplanung

/** Discord-User der über "Interessiert" am Scheduled Event teilnimmt (kein App-Login nötig) */
model DiscordRsvp {
  id            String   @id @default(cuid())
  eventId       String
  discordUserId String
  username      String
  displayName   String?
  avatar        String?
  /** Discord-Rollen des Users im Server (für automatische Rollenzuweisung) */
  discordRoles  String[]
  /** Zeitpunkt der Erst-Anmeldung – wird nie überschrieben */
  createdAt     DateTime  @default(now())
  /** Zeitpunkt der Abmeldung (Soft-Delete) – null = aktuell interessiert */
  leftAt        DateTime?
  /** Letzter Abmeldezeitpunkt – wird gesetzt wenn leftAt gesetzt wird, nie zurückgesetzt */
  lastLeftAt    DateTime?
  /** Gecachtes Item-Level aus dem Gilden-Roster (wird bei jedem Sync aktualisiert) */
  itemLevel     Int?
  updatedAt     DateTime  @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  raidSlots RaidSlot[]

  @@unique([eventId, discordUserId])
}

/** Kaderslot: Weist einen Discord-RSVP-User einer Rolle im Raid zu */
model RaidSlot {
  id            String    @id @default(cuid())
  eventId       String
  discordRsvpId String
  role          RaidRole
  position      Int
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  discordRsvp DiscordRsvp @relation(fields: [discordRsvpId], references: [id], onDelete: Cascade)

  @@unique([eventId, role, position])
}

enum RaidRole {
  TANK
  HEALER
  DPS
}

// #endregion

// #region Signup-Aktivitätslog

/** Protokolliert jede An- und Abmeldung zu einem Event */
model SignupActivity {
  id            String       @id @default(cuid())
  eventId       String
  userId        String
  /** Neuer Status nach der Änderung */
  newStatus     SignupStatus
  /** Vorheriger Status (null = Erstanmeldung) */
  previousStatus SignupStatus?
  createdAt     DateTime     @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// #endregion

// #region App-Einstellungen

/**
 * Singleton-Tabelle für App-weite Konfiguration.
 * Wird mit id="default" als einziger Datensatz genutzt (Upsert).
 */
model AppSettings {
  id                     String   @id @default("default")
  /** Max. Level für den Raid-Roster Filter (z.B. 80 für TWW, 70 für Dragonflight) */
  rosterMaxLevel         Int      @default(90)
  /** Intervall in Minuten für den serverseitigen Discord RSVP Cron-Job */
  discordPollIntervalMin Int      @default(5)
  updatedAt              DateTime @updatedAt
}

// #endregion

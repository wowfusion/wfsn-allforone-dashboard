# Kopiere diese Datei nach .env.local und fülle alle Werte aus.
# Nie echte Werte in diese Datei eintragen – sie wird versioniert.

# ─── Datenbank ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ein-langer-zufaelliger-string"

# ─── Discord OAuth (für Login) ─────────────────────────────────────────────────
DISCORD_CLIENT_ID="deine-discord-app-client-id"
DISCORD_CLIENT_SECRET="dein-discord-app-client-secret"

# ─── Discord Bot (für Scheduled Events & RSVP) ────────────────────────────────
DISCORD_BOT_TOKEN="dein-bot-token"
DISCORD_GUILD_ID="deine-server-id"

# Voice-Channel IDs für Scheduled Events
DISCORD_VOICE_CHANNEL_RAID="channel-id-fuer-raids"
DISCORD_VOICE_CHANNEL_EVENT="channel-id-fuer-events"

# Text-Channel ID für Event-Ankündigungen (jedes neue Event wird hier gepostet)
DISCORD_ANNOUNCE_CHANNEL_ID="channel-id-fuer-ankuendigungen"

# ─── Discord App-Rollenmapping ────────────────────────────────────────────────
# Welche Discord-Rollen-IDs bekommen welche Dashboard-Berechtigung?
# Mehrere IDs kommagetrennt möglich: 123,456,789
#
# MEMBER  → darf Events sehen und sich anmelden
# OFFICER → darf Events erstellen, bearbeiten, sperren, Kaderplanung
# ADMIN   → Vollzugriff inkl. Konfiguration
#
# Rollen-ID ermitteln: Discord → Einstellungen → Erweitert → Entwicklermodus,
# dann Rechtsklick auf die Rolle im Server → ID kopieren

DISCORD_ROLE_MEMBER="discord-rollen-id-fuer-mitglieder"
DISCORD_ROLE_OFFICER="discord-rollen-id-fuer-offiziere"
DISCORD_ROLE_ADMIN="discord-rollen-id-fuer-admins"

# ─── Discord WoW-Rollen (für automatische Kaderplan-Zuweisung) ────────────────
# Optional: Wenn Mitglieder im Discord-Server eine Rolle haben die ihrer
# WoW-Rolle entspricht, wird sie im Kaderplaner automatisch vorgeschlagen.
# Leer lassen wenn nicht verwendet.

DISCORD_ROLE_WOW_TANK="discord-rollen-id-fuer-tanks"
DISCORD_ROLE_WOW_HEALER="discord-rollen-id-fuer-heiler"
DISCORD_ROLE_WOW_DPS="discord-rollen-id-fuer-dps"

# ─── Cron-Job Sicherheit ──────────────────────────────────────────────────────
# Zufälliger String zum Absichern des Cron-Endpunkts.
# Wird als Header übergeben: Authorization: Bearer <CRON_SECRET>
# Leer lassen = Cron-Endpunkt ist öffentlich erreichbar (nicht empfohlen).
CRON_SECRET="ein-langer-zufaelliger-string"

# ─── Battle.net (Gilden-Roster Sync) ──────────────────────────────────────────
BNET_CLIENT_ID="deine-bnet-client-id"
BNET_CLIENT_SECRET="dein-bnet-client-secret"
